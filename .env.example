APP_ENV=development
SITE_URL=http://localhost:3000
SITE_TIMEZONE=Asia/Shanghai
API_INTERNAL_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite+aiosqlite:///./data/blog.db
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
HASH_SALT_SECRET=visitor-salt-key-replace-in-production
REVALIDATE_SECRET=internal-revalidate-secret-token

# 后台安全
# APP_ENV=production 时：上面三个密钥必须各不相同、换成 32 位以上的随机串，SITE_URL 必须是 https，否则 API 拒绝启动
# 生成随机串：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 只有来自这些地址（或网段）的请求，才信任它带来的 X-Forwarded-For；Docker 部署见 docker-compose.yml
TRUSTED_PROXIES=127.0.0.1,::1
ACCESS_TOKEN_MINUTES=15
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# Refresh Cookie 的 Secure 标记，默认生产环境开启；本机用 http 调试生产构建时可设为 false
# COOKIE_SECURE=false

# 腾讯云 COS (开发环境如未配置将自动平滑降级至本地模拟存储)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_CDN_DOMAIN=
COS_STS_DURATION=900

# GitHub 集成 (可选，用于项目 Star 同步)
GITHUB_TOKEN=

# 邮件通知 (可选，用于评论通知)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
